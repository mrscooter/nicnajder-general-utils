#!/usr/bin/env bash
# Switch Ghostty + Zellij themes together.
#   term-theme          list themes, mark the active one
#   term-theme next     rotate within the active group (light or dark)
#   term-theme <name>   any name from the list; "dark" is an alias for gold-dim
set -euo pipefail

# The shared (symlinked) configs never hold the theme, so switching stays per machine:
# Ghostty's config includes local.ghostty, Zellij's config uses the theme named "active".
GHOSTTY_LOCAL="$HOME/.config/ghostty/local.ghostty"
ZELLIJ_THEMES="$HOME/.config/zellij/themes"
ZELLIJ_ACTIVE="$ZELLIJ_THEMES/active.kdl"
LIGHT=(manuscript venetian library stone gold-light)
DARK=(manuscript-dark venetian-dark library-dark stone-dark gold-dim)

# Ghostty and Zellij theme files share a name: gold-* as is, the rest with a royal- prefix.
theme_file() { [[ $1 == gold-* ]] && echo "$1" || echo "royal-$1"; }
current() { sed -n '1s|^// term-theme: ||p' "$ZELLIJ_ACTIVE" 2>/dev/null || true; }

apply() {
    local f
    f=$(theme_file "$1")
    mkdir -p "$(dirname "$GHOSTTY_LOCAL")" "$ZELLIJ_THEMES"
    if grep -q '^theme = ' "$GHOSTTY_LOCAL" 2>/dev/null; then
        sed -i "s/^theme = .*/theme = $f/" "$GHOSTTY_LOCAL"
    else
        echo "theme = $f" >> "$GHOSTTY_LOCAL"
    fi
    { echo "// term-theme: $1"; sed "s/^    $f {/    active {/" "$ZELLIJ_THEMES/$f.kdl"; } > "$ZELLIJ_ACTIVE"
    # Ghostty reloads its config on SIGUSR2; Zellij reloads on theme-file changes by itself.
    pkill -USR2 -x ghostty || true
    echo "$1   ($f)"
}

rotate() {
    local cur=$1; shift
    local group=("$@") i
    for i in "${!group[@]}"; do
        [[ ${group[$i]} == "$cur" ]] && { echo "${group[$(( (i + 1) % ${#group[@]} ))]}"; return; }
    done
    echo "${group[0]}"
}

name=${1:-}
[[ $name == dark ]] && name=gold-dim

case "$name" in
    "")
        cur=$(current)
        for label in light dark; do
            echo "$label:"
            [[ $label == light ]] && group=("${LIGHT[@]}") || group=("${DARK[@]}")
            for t in "${group[@]}"; do
                [[ $t == "$cur" ]] && echo "  * $t" || echo "    $t"
            done
        done
        ;;
    next)
        cur=$(current)
        if [[ " ${LIGHT[*]} " == *" $cur "* ]]; then
            apply "$(rotate "$cur" "${LIGHT[@]}")"
        else
            apply "$(rotate "$cur" "${DARK[@]}")"
        fi
        ;;
    *)
        if [[ " ${LIGHT[*]} ${DARK[*]} " == *" $name "* ]]; then
            apply "$name"
        else
            echo "usage: term-theme [next|<name>]   names: ${LIGHT[*]} ${DARK[*]}" >&2
            exit 1
        fi
        ;;
esac
