#!/usr/bin/env bash
# Switch Ghostty + Zellij themes together.
#   term-theme          list themes, mark the active one
#   term-theme next     rotate within the active group (light or dark)
#   term-theme <name>   any name from the list; "dark" is an alias for gold-dim
set -euo pipefail

GHOSTTY_CONF="$HOME/.config/ghostty/config.ghostty"
ZELLIJ_CONF="$HOME/.config/zellij/config.kdl"
LIGHT=(manuscript venetian library stone)
DARK=(manuscript-dark venetian-dark library-dark stone-dark gold-dim)

# gold-dim is the original pairing: Ghostty's built-in Adventure + Zellij's gold-dim.
ghostty_theme() { [[ $1 == gold-dim ]] && echo Adventure || echo "royal-$1"; }
zellij_theme() { [[ $1 == gold-dim ]] && echo gold-dim || echo "royal-$1"; }
current() {
    local z
    z=$(sed -n 's/^theme "\(.*\)"/\1/p' "$ZELLIJ_CONF" 2>/dev/null || true)
    echo "${z#royal-}"
}

# Replace the file's top-level theme line, or append one on a fresh machine.
set_line() {
    local file=$1 pattern=$2 line=$3
    mkdir -p "$(dirname "$file")"
    if grep -q "$pattern" "$file" 2>/dev/null; then
        sed -i "s/$pattern.*/$line/" "$file"
    else
        echo "$line" >> "$file"
    fi
}

apply() {
    local g z
    g=$(ghostty_theme "$1"); z=$(zellij_theme "$1")
    set_line "$GHOSTTY_CONF" '^theme = ' "theme = $g"
    set_line "$ZELLIJ_CONF" '^theme "' "theme \"$z\""
    # Ghostty reloads its config on SIGUSR2; Zellij picks up config.kdl changes by itself.
    pkill -USR2 -x ghostty || true
    echo "$1   (ghostty: $g, zellij: $z)"
}

rotate() {
    local cur=$1; shift
    local group=("$@") i
    for i in "${!group[@]}"; do
        [[ ${group[$i]} == "$cur" ]] && { echo "${group[$(( (i + 1) % ${#group[@]} ))]}"; return; }
    done
    echo "${group[0]}"
}

name=${1:-}
[[ $name == dark ]] && name=gold-dim

case "$name" in
    "")
        cur=$(current)
        for label in light dark; do
            echo "$label:"
            [[ $label == light ]] && group=("${LIGHT[@]}") || group=("${DARK[@]}")
            for t in "${group[@]}"; do
                [[ $t == "$cur" ]] && echo "  * $t" || echo "    $t"
            done
        done
        ;;
    next)
        cur=$(current)
        if [[ " ${LIGHT[*]} " == *" $cur "* ]]; then
            apply "$(rotate "$cur" "${LIGHT[@]}")"
        else
            apply "$(rotate "$cur" "${DARK[@]}")"
        fi
        ;;
    *)
        if [[ " ${LIGHT[*]} ${DARK[*]} " == *" $name "* ]]; then
            apply "$name"
        else
            echo "usage: term-theme [next|<name>]   names: ${LIGHT[*]} ${DARK[*]}" >&2
            exit 1
        fi
        ;;
esac
