// Black background, gray text, muted gold accents.
// Zellij paints a pane's border and title with the same color (frame_selected.base),
// so the focused frame uses a muted gold and unfocused frames recede to dark gray.
themes {
    gold-dim {
        text_unselected {
            base 150 145 135
            background 12 12 12
            emphasis_0 176 142 72
            emphasis_1 120 116 108
            emphasis_2 150 120 60
            emphasis_3 176 142 72
        }
        text_selected {
            base 230 230 230
            background 48 44 36
            emphasis_0 214 178 96
            emphasis_1 160 160 160
            emphasis_2 168 140 80
            emphasis_3 176 92 64
        }
        ribbon_selected {
            base 12 12 12
            background 150 120 60
            emphasis_0 40 30 10
            emphasis_1 12 12 12
            emphasis_2 12 12 12
            emphasis_3 12 12 12
        }
        ribbon_unselected {
            base 150 145 135
            background 34 32 28
            emphasis_0 176 142 72
            emphasis_1 60 54 42
            emphasis_2 120 116 108
            emphasis_3 176 142 72
        }
        table_title {
            base 196 160 82
            background 0
            emphasis_0 214 178 96
            emphasis_1 150 150 150
            emphasis_2 168 140 80
            emphasis_3 176 92 64
        }
        table_cell_selected {
            base 230 230 230
            background 48 44 36
            emphasis_0 214 178 96
            emphasis_1 160 160 160
            emphasis_2 168 140 80
            emphasis_3 176 92 64
        }
        table_cell_unselected {
            base 180 180 180
            background 24 24 24
            emphasis_0 196 160 82
            emphasis_1 140 140 140
            emphasis_2 168 140 80
            emphasis_3 176 92 64
        }
        list_selected {
            base 230 230 230
            background 48 44 36
            emphasis_0 214 178 96
            emphasis_1 160 160 160
            emphasis_2 168 140 80
            emphasis_3 176 92 64
        }
        list_unselected {
            base 180 180 180
            background 24 24 24
            emphasis_0 196 160 82
            emphasis_1 140 140 140
            emphasis_2 168 140 80
            emphasis_3 176 92 64
        }
        frame_unselected {
            base 58 58 58
            background 0
            emphasis_0 110 110 110
            emphasis_1 110 110 110
            emphasis_2 110 110 110
            emphasis_3 110 110 110
        }
        frame_selected {
            base 150 120 60
            background 0
            emphasis_0 196 160 82
            emphasis_1 150 150 150
            emphasis_2 168 140 80
            emphasis_3 0
        }
        // base: focused frame in pane/tab/resize/... modes, and mouse-hovered panes.
        // emphasis_0/1: panes in a multi-select group.
        frame_highlight {
            base 204 166 84
            background 0
            emphasis_0 222 180 90
            emphasis_1 222 180 90
            emphasis_2 222 180 90
            emphasis_3 222 180 90
        }
        exit_code_success {
            base 150 160 90
            background 0
            emphasis_0 150 160 90
            emphasis_1 40 40 40
            emphasis_2 168 140 80
            emphasis_3 140 140 140
        }
        exit_code_error {
            base 190 80 60
            background 0
            emphasis_0 196 160 82
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 196 160 82
            player_2 140 140 140
            player_3 176 92 64
            player_4 168 140 80
            player_5 120 120 120
            player_6 214 178 96
            player_7 150 160 90
            player_8 100 100 100
            player_9 190 80 60
            player_10 180 180 180
        }
    }
}
