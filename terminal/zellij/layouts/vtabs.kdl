// Vertical tab bar on the left (cfal/zellij-vertical-tabs v0.1.0, plugins/zellij-vertical-tabs.wasm).
// Usage: zellij -l vtabs. Alt s (config.kdl) toggles the bar selectable, to focus and resize it.

layout {
    pane split_direction="vertical" {
        pane size=18 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm" {
                // The plugin can't read the Zellij theme, so colors are ANSI palette slots
                // (3 accent, 8 dim, default text) and follow the terminal theme; term-theme
                // pairs every Ghostty palette with its matching Zellij theme.
                // On inactive rows fill draws nothing; it only makes the plugin reset the
                // index color, which an unstyled {name} would otherwise inherit.
                format "#[fg=8]{index} #[fg=none,fill]{name}"
                // Like Zellij's own active tab: accent background, text in the background color.
                format_active "#[bg=3,fill,bold]▶ {index} {name} {indicators}"
                indicator_active ""
                indicator_fullscreen "□"
                indicator_sync "⇄"
                max_name_length 14
            }
        }
        pane
    }
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
